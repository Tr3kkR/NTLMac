<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for NTLMacAgent only (the shim gets none). make-app.sh replaces __TEAM_ID__
  with the signing identity's team ID; it must match CodeSigningPolicy.keychainAccessGroup.
  keychain-access-groups is restricted: Apple documents it as needing a provisioning
  profile (TN3125, TN3137), so distribution builds embed one (make-app.sh
  PROVISIONING_PROFILE, which also adds the application-identifier and team-identifier
  entitlements). Without one it worked in our tests on macOS 26.5 (development
  certificate), but that is undocumented.
-->
<plist version="1.0">
<dict>
  <key>keychain-access-groups</key>
  <array>
    <string>__TEAM_ID__.com.devnull.ntlmac</string>
  </array>
</dict>
</plist>
