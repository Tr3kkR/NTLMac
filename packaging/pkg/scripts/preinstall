#!/bin/sh
# Before an upgrade replaces the app: stop the agent in every GUI session, so no old
# agent keeps running from a deleted binary. A first install finds nothing to stop.
[ "$3" = "/" ] || exit 0
LABEL=com.devnull.ntlmac.agent

for uid in $(ps -axo uid=,comm= | awk '$2 ~ /\/loginwindow$/ && $1 != 0 { print $1 }' | sort -u); do
  launchctl bootout "gui/$uid/$LABEL" 2>/dev/null || continue
  # bootout can return before the job is gone.
  i=0
  while launchctl print "gui/$uid/$LABEL" >/dev/null 2>&1 && [ "$i" -lt 50 ]; do
    sleep 0.1; i=$((i + 1))
  done
  echo "NTLMac: stopped the agent for uid $uid"
done
exit 0
